# Copier ce fichier en .env et adapter si besoin (les valeurs par défaut correspondent au docker-compose.yml)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB_SOURCE=src_fournisseurs
PG_DB_DWH=dwh_scms
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scms
MYSQL_PASSWORD=scms
MYSQL_DB=src_entrepots
# 1 = ne pas appeler les API (utilise les instantanés de data/api_cache) ; 0 = API en direct avec repli automatique
OFFLINE=0
# Clés gratuites (facultatives) : https://www.eia.gov/opendata/  et  https://comtradedeveloper.un.org/
EIA_API_KEY=
COMTRADE_API_KEY=
# Facteur de montée en charge des sources générées (1 = ~1,2 million de lignes, 3 = ~3,4 millions)
ECHELLE=1
